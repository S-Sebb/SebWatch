import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, ThemeChoice, Art, SegmentKind, SegmentFill, Swatch, Dashed, Card, Chevron } from "theme.slint";

export { Theme, ThemeChoice, Art, SegmentKind }

// One part of the RAM or swap bar.
export struct Segment {
    kind: SegmentKind,
    // The app's series colour, 0 to 6; only for kind app.
    series: int,
    name: string,
    // Shown after the name in the tooltip, e.g. "· guide35".
    detail: string,
    // Share of the bar; a bar's fractions add up to 1.
    fraction: float,
    // The fractions of the segments before it.
    start: float,
    // The size, e.g. "2.7 GB": in the legend, and also in the segment when labelled.
    size: string,
    labelled: bool,
    // The tooltip's first line, then its muted lines.
    tip: string,
    notes: [string],
    // The tooltip in one line, for screen readers.
    description: string,
    // A click's target: the app's row key, the "N more apps" fold's for Other apps, empty for
    // a section that does nothing.
    key: string,
}

export struct Bar {
    title: string,
    total: string,
    // Inside an empty bar: why it is empty, e.g. "The NVIDIA driver is not answering".
    note: string,
    segments: [Segment],
}

// The Swap title's popup, "Memory pressure and swap". Empty lines are left out.
export struct SwapInfo {
    // Pressure is high: the warning chip shows.
    high: bool,
    // "High:", "Some:" or "None:"; empty where the kernel doesn't track pressure.
    level: string,
    pressure: string,
    swap: string,
    zswap: string,
    // The apps with the most swap, as the swap bar's segments (name and size).
    top: [Segment],
    closing: string,
}

export struct Tile {
    name: string,
    value: string,
    unit: string,
    // Has a graph of the last minute: not while the GPU sleeps.
    graphed: bool,
    // That minute as SVG path commands in a 290 x 100 box: the line, and the area under it.
    // Empty before two readings in a row.
    line: string,
    area: string,
    // The GPU tile with an Intel or AMD GPU: the NVIDIA GPU's figure, unit and line beside the
    // first; empty without one.
    value2: string,
    unit2: string,
    line2: string,
    // What the figure measures, in the tooltip; a second line after a newline.
    about: string,
}

// A tooltip opened by the keyboard focus, drawn over the window: where, and what it says.
struct KeyTip {
    shown: bool,
    // The tip's left edge, or its right edge when `right`.
    x: length,
    y: length,
    right: bool,
    title: string,
    about: string,
}

export enum RowKind { app, group, process, kernel, more }

// A key the table acts on; toggle is Enter or Space.
export enum TableKey { up, down, home, end, left, right, toggle }

// A table row: an app, one of an expanded app's processes or child groups, its kernel share,
// the fold holding the rest, or Closed apps (cache). Absent values are "—".
export struct Row {
    kind: RowKind,
    // 0 for an app, 1 under it, 2 for a process under one of its groups.
    depth: int,
    key: string,
    name: string,
    detail: string,
    // The app's colour in the bars, or -1 when it has none.
    series: int,
    icon: image,
    expanded: bool,
    ram: string,
    swap: string,
    cache: string,
    cpu: string,
    disk: string,
    // The Intel or AMD GPU; empty without one.
    igpu: string,
    // Why that figure is "n/a" (KWin hides its GPU use); empty otherwise.
    igpu-tip: string,
    gpu: string,
    vram: string,
    // Shown on hover; empty for none.
    tip: string,
    // Ended while the window is paused: greyed until it resumes.
    ended: bool,
}

component Label inherits Text {
    color: Theme.fg;
    vertical-alignment: center;
}

component Muted inherits Label {
    color: Theme.muted;
}

component SectionTitle inherits Label {
    font-family: Theme.title-font;
    font-size: Theme.title-size;
    font-weight: Theme.title-weight;
}

// A tooltip's box; its children are stacked.
component TipCard inherits Rectangle {
    background: Theme.popup;
    border-width: 1px;
    border-color: Theme.picnic ? Theme.outline : Theme.line;
    border-radius: Theme.picnic ? 0 : 4px;
    drop-shadow-blur: Theme.picnic ? 0 : 10px;
    drop-shadow-offset-y: 3px;
    drop-shadow-offset-x: Theme.picnic ? 3px : 0;
    drop-shadow-color: Theme.picnic ? #5B331C30 : #00000040;
    VerticalLayout {
        padding-left: Theme.picnic ? 10px : 9px;
        padding-right: self.padding-left;
        padding-top: Theme.picnic ? 8px : 6px;
        padding-bottom: self.padding-top;
        spacing: 2px;
        @children
    }
}

// The keyboard focus: Breeze's 1 px accent frame inside the item, or a 2 px square one in SebChat.
component FocusRing {
    Rectangle {
        x: Theme.picnic ? 0 : 1px;
        y: self.x;
        width: root.width - 2 * self.x;
        height: root.height - 2 * self.y;
        border-width: Theme.picnic ? 2px : 1px;
        border-radius: Theme.picnic ? 0 : 3px;
        border-color: Theme.accent;
    }
}

// A figure's name and what it measures, in the bars' tooltip style. Screen readers get the same
// words as the figure's description.
component AboutTip inherits TipCard {
    in property <string> title;
    in property <string> about;
    Label {
        text: root.title;
        font-size: Theme.small;
        font-weight: Theme.picnic ? 800 : 700;
        accessible-role: none;
    }
    Muted {
        text: root.about;
        font-size: Theme.small;
        accessible-role: none;
    }
}

// The tooltip of the item the keyboard is on, opened at once, kept inside the window.
component FocusTip inherits AboutTip {
    in property <KeyTip> tip;
    in property <length> room;
    title: self.tip.title;
    about: self.tip.about;
    width: self.preferred-width;
    height: self.preferred-height;
    x: max(8px, min(self.room - self.width - 8px, self.tip.right ? self.tip.x - self.width : self.tip.x));
    y: self.tip.y;
}

// A bar's section as a screen reader's list item.
component SectionItem {
    in property <Segment> segment;
    in property <int> index;
    width: 100%;
    height: 100%;
    accessible-role: list-item;
    accessible-label: self.segment.detail == "" ? self.segment.name : self.segment.name + " " + self.segment.detail;
    accessible-description: self.segment.description;
    accessible-item-index: self.index;
}

// A section a click acts on (`Segment.key`): only these offer screen readers a default action.
component PickableSection inherits SectionItem {
    callback picked();
    accessible-action-default => {
        root.picked();
    }
}

component SegmentBar {
    in property <[Segment]> segments;
    in property <string> note;
    in property <string> title;
    in property <length> gap: 2px;
    property <length> share: self.width - (self.segments.length - 1) * self.gap;
    property <int> hovered: -1;
    // A section with a key (`Segment.key`) clicked.
    callback picked(string);
    height: 28px;
    // A list of parts, so it carries over to another chart.
    accessible-role: list;
    accessible-label: self.title;
    accessible-item-count: self.segments.length;

    // An empty bar: a sleeping GPU's VRAM, not read so as not to wake it.
    if root.segments.length == 0: Dashed {
        width: 100%;
        height: 100%;
    }
    if root.segments.length == 0 && root.note != "": Muted {
        x: 10px;
        text: root.note;
        font-size: Theme.small;
    }

    for s[i] in root.segments: Rectangle {
            x: s.start * root.share + i * root.gap;
            width: s.fraction * root.share;
            border-radius: Theme.radius;
            clip: true;
            background: SegmentFill.color(s.kind, s.series);
            if s.kind == SegmentKind.cache || s.kind == SegmentKind.closed: Image {
                width: 100%;
                height: 100%;
                source: Art.hatch;
                colorize: Theme.hatch;
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
            }
            if s.kind == SegmentKind.free: Dashed {
                width: 100%;
                height: 100%;
            }
            // Hidden where it doesn't fit, never clipped; the legend then gives the size.
            if s.labelled: Label {
                x: 6px;
                visible: self.preferred-width + 12px <= s.fraction * root.share;
                text: s.size;
                font-size: Theme.small;
                color: SegmentFill.ink(s.kind, s.series);
            }
    }

    // The hover ring and tooltip, laid out over the segments so a ring is drawn above both neighbours.
    for s[i] in root.segments: Rectangle {
            x: s.start * root.share + i * root.gap;
            width: s.fraction * root.share;
            if s.key == "": SectionItem {
                segment: s;
                index: i;
            }
            if s.key != "": PickableSection {
                segment: s;
                index: i;
                picked => {
                    root.picked(s.key);
                }
            }
            if touch.has-hover: Rectangle {
                x: Theme.picnic ? -4px : -3px;
                y: self.x;
                width: parent.width - 2 * self.x;
                height: parent.height - 2 * self.y;
                border-radius: Theme.picnic ? 0 : Theme.radius + 3px;
                border-width: 1px;
                border-color: Theme.fg;
                Rectangle {
                    x: Theme.picnic ? 0 : 1px;
                    y: self.x;
                    width: parent.width - 2 * self.x;
                    height: parent.height - 2 * self.y;
                    border-radius: Theme.picnic ? 0 : Theme.radius + 2px;
                    border-width: Theme.picnic ? 2px : 2px;
                    border-color: Theme.picnic ? Theme.fg : Theme.bg;
                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        visible: Theme.picnic;
                        border-width: 2px;
                        border-color: Theme.view;
                    }
                }
            }
            touch := TouchArea {
                mouse-cursor: s.key == "" ? MouseCursor.default : MouseCursor.pointer;
                clicked => {
                    if s.key != "" {
                        root.picked(s.key);
                    }
                }
            }

            Tooltip {
                TipCard {
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Swatch {
                                    kind: s.kind;
                                    series: s.series;
                                }
                            }
                            Label {
                                text: s.detail == "" ? s.name : s.name + " " + s.detail;
                                font-size: Theme.small;
                                font-weight: Theme.picnic ? 800 : 700;
                            }
                        }
                        Label {
                            text: s.tip;
                            font-size: Theme.small;
                        }
                        for note in s.notes: Muted {
                            text: note;
                            font-size: Theme.small;
                        }
                }
            }
    }
}

// One line of the swap popup: a muted key, then its text; read as one text by screen readers.
component InfoLine {
    in property <string> key;
    in property <string> text;
    accessible-role: AccessibleRole.text;
    accessible-label: self.key;
    accessible-description: self.text;
    HorizontalLayout {
        spacing: 10px;
        Muted {
            width: 96px;
            text: root.key;
            font-size: Theme.small;
            vertical-alignment: top;
        }
        @children
    }
}

// Opens the popup on a click, Enter or Space, with a focus frame only after a key.
component InfoTrigger {
    callback open(bool);
    in property <bool> keyboard;
    out property <bool> has-hover: touch.has-hover;
    accessible-role: button;
    accessible-action-default => {
        root.open(false);
    }
    @children
    if scope.has-focus && root.keyboard: FocusRing {
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        clicked => {
            root.open(false);
        }
    }
    scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.open(true);
                return accept;
            }
            reject
        }
    }
    public function take-focus() {
        scope.focus();
    }
}

// After the Swap title: the ⓘ button, then "Memory pressure high" while it is; either opens the
// popup "Memory pressure and swap", below the title. It stays open until Escape, a click
// outside or a second click on them (Slint closes it on that press and doesn't pass it on).
component SwapExplain {
    in property <SwapInfo> info;
    property <bool> keyboard;
    horizontal-stretch: 0;

    function open(keyboard: bool) {
        root.keyboard = keyboard;
        popup.show();
    }

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            button := InfoTrigger {
                width: 18px;
                height: 18px;
                keyboard: root.keyboard;
                accessible-label: "Memory pressure and swap";
                open(keyboard) => {
                    root.open(keyboard);
                }
                Rectangle {
                    border-radius: Theme.picnic ? 0 : 9px;
                    border-width: Theme.picnic ? 2px : 1px;
                    border-color: Theme.picnic ? Theme.outline : button.has-hover ? Theme.accent : Theme.muted;
                    background: button.has-hover ? Theme.hover : transparent;
                    Text {
                        text: "i";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.picnic ? Theme.fg : button.has-hover ? Theme.accent : Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        if root.info.high: VerticalLayout {
            alignment: center;
            InfoTrigger {
                keyboard: root.keyboard;
                accessible-label: "Memory pressure high";
                open(keyboard) => {
                    root.open(keyboard);
                }
                Rectangle {
                    background: Theme.warning-bg;
                    border-width: 1px;
                    border-color: Theme.warning;
                    border-radius: Theme.picnic ? 0 : 3px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            // The warning triangle of the "Not updating" message.
                            Rectangle {
                                width: 14px;
                                height: 14px;
                                Path {
                                    width: 14px;
                                    height: 14px;
                                    viewbox-width: 32;
                                    viewbox-height: 32;
                                    commands: "M 16 3 L 30 28 L 2 28 Z";
                                    fill: Theme.warning;
                                }
                                Text {
                                    y: 4px;
                                    height: 9px;
                                    text: "!";
                                    color: #ffffff;
                                    font-size: 9px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Label {
                            text: "Memory pressure high";
                            font-size: Theme.small;
                        }
                    }
                }
            }
        }
    }

    popup := PopupWindow {
        x: -root.x;
        y: root.height + 8px;
        width: 500px;
        close-policy: close-on-click-outside;
        TipCard {
            accessible-role: groupbox;
            accessible-label: "Memory pressure and swap";
            FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        popup.close();
                        if root.keyboard {
                            button.take-focus();
                        }
                        return accept;
                    }
                    reject
                }
                VerticalLayout {
                    padding-left: 3px;
                    padding-right: 3px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 6px;
                    SectionTitle {
                        text: "Memory pressure and swap";
                        font-size: Theme.picnic ? 20px : Theme.font-size;
                        accessible-role: none;
                    }
                    Rectangle {
                        height: 2px;
                    }
                    if root.info.level != "": InfoLine {
                        key: "Pressure";
                        text: root.info.level + " " + root.info.pressure;
                        StyledText {
                            text: @markdown("**\{root.info.level}** \{root.info.pressure}");
                            default-color: Theme.fg;
                            horizontal-stretch: 1;
                        }
                    }
                    InfoLine {
                        key: "Swap";
                        text: root.info.swap;
                        Label {
                            text: root.info.swap;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    if root.info.zswap != "": InfoLine {
                        key: "zswap";
                        text: root.info.zswap;
                        Label {
                            text: root.info.zswap;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    if root.info.top.length > 0: InfoLine {
                        key: "Most in swap";
                        text: "";
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            for s in root.info.top: HorizontalLayout {
                                spacing: 5px;
                                accessible-role: list-item;
                                accessible-label: s.name;
                                accessible-description: s.size;
                                VerticalLayout {
                                    alignment: center;
                                    Swatch {
                                        kind: s.kind;
                                        series: s.series;
                                    }
                                }
                                Label {
                                    text: s.name + " " + s.size;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    if root.info.closing != "": InfoLine {
                        key: "Closing it";
                        text: root.info.closing;
                        Label {
                            text: root.info.closing;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}

component BarView {
    in property <Bar> bar;
    // The swap bar: the ⓘ button and the pressure chip after the title.
    in property <bool> explained;
    in property <SwapInfo> info;
    callback picked <=> segments.picked;
    vertical-stretch: 0;
    VerticalLayout {
        spacing: 5px;
        HorizontalLayout {
            spacing: 8px;
            title := SectionTitle {
                text: root.bar.title;
            }
            if root.explained: SwapExplain {
                info: root.info;
            }
            Muted {
                horizontal-stretch: 1;
                text: root.bar.total;
                horizontal-alignment: right;
                vertical-alignment: bottom;
            }
            // After the total: the menu button in the bars card's top-right corner. As high as the
            // title, so a taller button hangs over the header instead of deepening it.
            HorizontalLayout {
                height: title.preferred-height;
                @children
            }
        }
        segments := SegmentBar {
            title: root.bar.title + ", " + root.bar.total;
            segments: root.bar.segments;
            note: root.bar.note;
        }
        // An empty FlexboxLayout limits the column's width to almost nothing.
        if root.bar.segments.length > 0: FlexboxLayout {
            padding-top: 2px;
            // Slint 1.18 lays out the card with too few legend rows at narrow widths (rows then
            // run into the next title); its own preferred height counts them right.
            min-height: self.preferred-height;
            spacing-horizontal: 14px;
            spacing-vertical: 4px;
            for s in root.bar.segments: HorizontalLayout {
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Swatch {
                        kind: s.kind;
                        series: s.series;
                    }
                }
                // Every size, also those the bar shows inside (#87).
                Label {
                    text: s.name + "  " + s.size;
                    font-size: Theme.small;
                }
            }
        }
    }
}

// A tile's figure and the unit under it; a coloured dot before the unit keys it to its line in
// the GPU tile's graph (transparent for none).
component TileFigure inherits VerticalLayout {
    in property <string> value;
    in property <string> unit;
    in property <color> dot;
    spacing: 2px;
    horizontal-stretch: 1;
    // No value while the GPU sleeps (the unit says so), but the same room for it.
    Label {
        text: root.value;
        font-family: Theme.picnic ? "Jersey 10" : "";
        font-size: Theme.picnic ? 32px : 22px;
        // Without the font's full leading, leaving the graph more room.
        height: Theme.picnic ? 30px : 26px;
    }
    HorizontalLayout {
        spacing: 5px;
        alignment: start;
        if root.dot != transparent: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: Theme.picnic ? 0 : 4px;
                background: root.dot;
            }
        }
        Muted {
            text: root.unit;
            font-size: Theme.small;
        }
    }
}

component TileView inherits Card {
    in property <Tile> tile;
    in property <int> index;
    in property <bool> focused;
    // The NVIDIA GPU's colour beside the Intel or AMD one's accent.
    property <color> second: Theme.picnic ? #8a63d2 : Theme.muted;
    inset: Theme.picnic ? 12px : 0;
    // The graph runs to the frame's corners.
    clip-content: true;
    // AT-SPI (AccessKit 0.24) passes on no text values, so the values start the description.
    accessible-role: list-item;
    accessible-label: self.tile.name;
    accessible-description: (self.tile.value == "" ? self.tile.unit : self.tile.value + " " + self.tile.unit) + (self.tile.unit2 == "" ? "" : self.tile.value2 == "" ? ", " + self.tile.unit2 : ", " + self.tile.value2 + " " + self.tile.unit2) + ". " + self.tile.about;
    accessible-item-index: self.index;
    // Every tile the same size, graph or not, sharing out the bars' height.
    vertical-stretch: 1;
    Rectangle {
        VerticalLayout {
            padding-top: Theme.picnic ? 0 : 7px;
            // Breeze keeps a near-zero line clear of the tile's border.
            padding-bottom: Theme.picnic ? 0 : 3px;
            spacing: 2px;
            VerticalLayout {
                padding-left: Theme.picnic ? 0 : 10px;
                padding-right: self.padding-left;
                vertical-stretch: 0;
                Muted {
                    text: root.tile.name;
                    font-size: Theme.small;
                    font-weight: Theme.picnic ? 800 : 400;
                }
                HorizontalLayout {
                    TileFigure {
                        value: root.tile.value;
                        unit: root.tile.unit;
                        dot: root.tile.unit2 == "" ? transparent : Theme.accent;
                    }
                    if root.tile.unit2 != "": TileFigure {
                        value: root.tile.value2;
                        unit: root.tile.unit2;
                        // None beside "NVIDIA asleep": it has no line.
                        dot: root.tile.value2 == "" ? transparent : root.second;
                    }
                }
            }
            // The last minute along the bottom, below the words so no line runs under them;
            // the same room left empty without a graph.
            Rectangle {
                min-height: 16px;
                vertical-stretch: 1;
                if root.tile.area != "": Path {
                    viewbox-width: 290;
                    viewbox-height: 100;
                    fit: fill;
                    commands: root.tile.area;
                    fill: Theme.accent.with-alpha(0.19);
                    // Fitted like the line, which leaves room for its stroke.
                    stroke: transparent;
                    stroke-width: Theme.picnic ? 2px : 1.5px;
                }
                if root.tile.line2 != "": Path {
                    viewbox-width: 290;
                    viewbox-height: 100;
                    fit: fill;
                    commands: root.tile.line2;
                    stroke: root.second;
                    stroke-width: Theme.picnic ? 2px : 1.5px;
                }
                if root.tile.line != "": Path {
                    viewbox-width: 290;
                    viewbox-height: 100;
                    fit: fill;
                    commands: root.tile.line;
                    stroke: Theme.accent;
                    stroke-width: Theme.picnic ? 2px : 1.5px;
                }
            }
        }
        // The whole tile, out to the frame the inset leaves.
        Rectangle {
            x: -root.inset;
            y: -root.inset;
            width: parent.width + 2 * root.inset;
            height: parent.height + 2 * root.inset;
            if root.focused: FocusRing {
                width: 100%;
                height: 100%;
            }
            // The focused tile's tooltip is already open.
            if !root.focused: Tooltip {
                AboutTip {
                    title: root.tile.name;
                    about: root.tile.about;
                }
            }
        }
    }
}

// The tiles, one Tab stop: the arrows move between them, and the focused one says what it
// measures. Clicks leave the focus where it is, as on the headers.
component TileStrip inherits FocusScope {
    in property <[Tile]> tiles;
    // Two by two.
    in property <bool> wide;
    in property <length> gap;
    // The grid's height, for the room left for it.
    out property <length> needs: grid.min-height;
    property <int> current;
    // The tile the keyboard is on, should the tiles grow fewer.
    property <int> at: min(self.current, self.tiles.length - 1);
    property <int> columns: self.wide ? 2 : 1;
    // Every tile is as high: they share the height evenly.
    property <int> rows: ceil(self.tiles.length / self.columns);
    property <length> tile-height: (self.height - (self.rows - 1) * self.gap) / self.rows;
    // To the right of the tile, level with its top.
    out property <KeyTip> tip: {
        shown: self.has-focus && self.at >= 0,
        x: self.absolute-position.x + mod(self.at, self.columns) * (180px + self.gap) + 180px + 10px,
        y: self.absolute-position.y + floor(self.at / self.columns) * (self.tile-height + self.gap),
        right: false,
        title: self.at >= 0 ? self.tiles[self.at].name : "",
        about: self.at >= 0 ? self.tiles[self.at].about : "",
    };
    focus-on-click: false;
    accessible-role: list;
    accessible-label: "Totals";
    accessible-item-count: self.tiles.length;
    accessible-delegate-focus: self.at;
    key-pressed(event) => {
        if event.modifiers.control || event.modifiers.alt {
            return reject;
        }
        if event.text == Key.LeftArrow {
            root.current = max(0, root.at - 1);
        } else if event.text == Key.RightArrow {
            root.current = min(root.tiles.length - 1, root.at + 1);
        } else if event.text == Key.UpArrow {
            root.current = root.at >= root.columns ? root.at - root.columns : root.at;
        } else if event.text == Key.DownArrow {
            root.current = root.at + root.columns < root.tiles.length ? root.at + root.columns : root.at;
        } else if event.text == Key.Home {
            root.current = 0;
        } else if event.text == Key.End {
            root.current = root.tiles.length - 1;
        } else {
            return reject;
        }
        accept
    }
    grid := GridLayout {
        spacing: root.gap;
        for tile[i] in root.tiles: TileView {
            tile: tile;
            index: i;
            focused: root.has-focus && i == root.at;
            // Fixed: the grid would otherwise give the columns unequal widths.
            width: 180px;
            row: floor(i / root.columns);
            col: mod(i, root.columns);
        }
    }
}

// The settings menu: for now only the theme. Enter, Space or Down opens it; in it, the arrows
// move, Enter or Space picks and Escape closes.
component MenuButton {
    property <[{choice: ThemeChoice, name: string, note: string}]> choices: [
        { choice: ThemeChoice.system, name: "System", note: "(follows the desktop)" },
        { choice: ThemeChoice.light, name: "Light", note: "" },
        { choice: ThemeChoice.dark, name: "Dark", note: "" },
        { choice: ThemeChoice.sebchat, name: "SebChat", note: "" },
    ];
    callback chosen(ThemeChoice);
    // The item the keyboard is on.
    property <int> current;
    // Focus frames only after a key, as in KDE apps.
    property <bool> keyboard;
    width: 30px;
    height: 30px;
    accessible-role: button;
    accessible-label: "Menu";
    accessible-description: "Theme";
    accessible-action-default => {
        root.open(false);
    }

    function open(keyboard: bool) {
        root.keyboard = keyboard;
        root.current = Theme.choice == ThemeChoice.system ? 0 : Theme.choice == ThemeChoice.light ? 1 : Theme.choice == ThemeChoice.dark ? 2 : 3;
        menu.show();
    }

    function choose(choice: ThemeChoice) {
        Theme.choice = choice;
        root.chosen(choice);
        menu.close();
        if root.keyboard {
            scope.focus();
        }
    }

    Rectangle {
        background: touch.pressed ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
        border-radius: Theme.picnic ? 0 : 3px;
        border-width: touch.has-hover && !Theme.picnic ? 1px : 0;
        border-color: Theme.accent;
    }

    // Three lines; square pixels in SebChat.
    for i in 3: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - 12px) / 2 + i * (Theme.picnic ? 5px : 5px) ;
        width: 16px;
        height: Theme.picnic ? 3px : 1.5px;
        background: Theme.fg;
    }
    if scope.has-focus && root.keyboard: FocusRing {
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        clicked => {
            root.open(false);
        }
    }
    scope := FocusScope {
        focus-gained(reason) => {
            root.keyboard = reason == FocusReason.tab-navigation || root.keyboard;
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow {
                root.open(true);
                return accept;
            }
            reject
        }
    }

    menu := PopupWindow {
        x: root.width - 230px;
        y: root.height + 2px;
        width: 230px;
        Rectangle {
            background: Theme.popup;
            border-width: Theme.picnic ? 3px : 1px;
            border-color: Theme.picnic ? Theme.outline : Theme.line;
            border-radius: Theme.picnic ? 0 : 4px;
            drop-shadow-blur: Theme.picnic ? 0 : 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-offset-x: Theme.picnic ? 3px : 0;
            drop-shadow-color: Theme.picnic ? #5B331C30 : #00000040;
            VerticalLayout {
                padding: Theme.picnic ? 7px : 4px;
                spacing: 0;
                HorizontalLayout {
                    padding-left: 10px;
                    height: 24px;
                    Muted {
                        text: "Theme";
                        font-size: Theme.small;
                        font-weight: Theme.picnic ? 800 : 400;
                    }
                }
                // Only the items in the scope, so the screen reader's focus follows `current`.
                items := FocusScope {
                    accessible-role: radio-group;
                    accessible-label: "Theme";
                    accessible-delegate-focus: root.current;
                    accessible-item-count: root.choices.length;
                    init => {
                        self.focus();
                    }
                    key-pressed(event) => {
                        if event.text == Key.UpArrow {
                            root.current = Math.max(0, root.current - 1);
                        } else if event.text == Key.DownArrow {
                            root.current = Math.min(root.choices.length - 1, root.current + 1);
                        } else if event.text == Key.Home {
                            root.current = 0;
                        } else if event.text == Key.End {
                            root.current = root.choices.length - 1;
                        } else if event.text == Key.Return || event.text == " " {
                            root.choose(root.choices[root.current].choice);
                        } else if event.text == Key.Escape {
                            menu.close();
                            if root.keyboard {
                                scope.focus();
                            }
                        } else {
                            return reject;
                        }
                        root.keyboard = true;
                        accept
                    }
                    VerticalLayout {
                        for c[i] in root.choices: Rectangle {
                            height: 26px;
                            border-radius: Theme.picnic ? 0 : 3px;
                            background: Theme.choice == c.choice ? Theme.selection : item.has-hover ? Theme.hover : transparent;
                            accessible-role: radio-button;
                            accessible-label: c.name;
                            accessible-description: c.note;
                            accessible-checkable: true;
                            accessible-checked: Theme.choice == c.choice;
                            accessible-item-index: i;
                            accessible-action-default => {
                                root.choose(c.choice);
                            }
                            Label {
                                x: 9px;
                                text: Theme.choice == c.choice ? "✓" : "";
                            }
                            HorizontalLayout {
                                padding-left: 26px;
                                spacing: 4px;
                                alignment: start;
                                Label {
                                    text: c.name;
                                }
                                Muted {
                                    text: c.note;
                                    color: Theme.choice == c.choice ? Theme.selected-muted : Theme.muted;
                                }
                            }
                            if i == root.current && root.keyboard: FocusRing {
        width: 100%;
        height: 100%;
    }
                            item := TouchArea {
                                clicked => {
                                    root.choose(c.choice);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// The icons of the buttons and strips: End's stop sign, Kill's red cross, Pause, Resume, and the
// strips' info and warning signs.
enum Glyph { none, end, kill, pause, play, info, warn }

component GlyphIcon {
    in property <Glyph> glyph;
    in property <length> size: 16px;
    width: self.glyph == Glyph.none ? 0 : self.size;
    height: self.size;
    if root.glyph == Glyph.end: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 2 A 6 6 0 1 1 8 14 A 6 6 0 1 1 8 2 M 5.5 8 L 10.5 8";
        stroke: Theme.fg;
        stroke-width: Theme.picnic ? 1.6px : 1.2px;
    }
    if root.glyph == Glyph.kill || root.glyph == Glyph.info: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 1.5 A 6.5 6.5 0 1 1 8 14.5 A 6.5 6.5 0 1 1 8 1.5 Z";
        fill: root.glyph == Glyph.kill ? Theme.negative : Theme.accent;
    }
    if root.glyph == Glyph.kill: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5.5 5.5 L 10.5 10.5 M 10.5 5.5 L 5.5 10.5";
        stroke: #ffffff;
        stroke-width: 1.6px;
    }
    if root.glyph == Glyph.info: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 7 L 8 12 M 8 4 L 8 5.6";
        stroke: #ffffff;
        stroke-width: 1.6px;
    }
    if root.glyph == Glyph.warn: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M 16 3 L 30 28 L 2 28 Z";
        fill: Theme.warning;
    }
    if root.glyph == Glyph.warn: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M 16 11 L 16 20 M 16 22 L 16 24.4";
        stroke: #ffffff;
        stroke-width: 2.4px;
    }
    if root.glyph == Glyph.pause: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 4 3 L 6.5 3 L 6.5 13 L 4 13 Z M 9.5 3 L 12 3 L 12 13 L 9.5 13 Z";
        fill: Theme.fg;
    }
    if root.glyph == Glyph.play: Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5 3 L 13 8 L 5 13 Z";
        fill: Theme.fg;
    }
}

// A push button: Breeze's framed face, or SebChat's outlined one with a hard shadow. A long
// label ends in an ellipsis; Enter or Space presses it from the keyboard.
component PushButton {
    in property <string> text;
    in property <Glyph> glyph;
    // Pressed in: Resume while the window is paused.
    in property <bool> on;
    in property <bool> danger;
    // The tooltip: a first line, then muted lines; none when empty.
    in property <string> tip;
    in property <[string]> notes;
    callback clicked();
    // Focus frames only after a key, as in KDE apps.
    property <bool> keyboard;
    height: Theme.picnic ? 30px : 28px;
    // As wide as its label; narrower only to fit, never wider.
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.notes.length > 0 ? root.notes[0] : "";
    accessible-action-default => {
        root.clicked();
    }

    public function focus-button() {
        root.keyboard = true;
        scope.focus();
    }

    if Theme.picnic: Rectangle {
        x: 2px;
        y: 2px;
        background: #5B331C30;
    }
    Rectangle {
        background: root.danger ? Theme.negative : root.on ? Theme.selection : touch.has-hover ? Theme.hover : Theme.button;
        border-width: Theme.picnic ? 2px : 1px;
        border-radius: Theme.picnic ? 0 : 3px;
        border-color: root.danger ? (Theme.picnic ? Theme.outline : Theme.negative) : root.on || touch.has-hover ? Theme.accent : Theme.button-line;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        if root.glyph != Glyph.none: VerticalLayout {
            alignment: center;
            GlyphIcon {
                glyph: root.glyph;
            }
        }
        Label {
            text: root.text;
            overflow: elide;
            color: root.danger ? #ffffff : Theme.fg;
            font-weight: Theme.picnic ? 800 : Theme.weight;
        }
    }
    if scope.has-focus && root.keyboard: FocusRing {
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        clicked => {
            root.keyboard = false;
            root.clicked();
        }
    }
    scope := FocusScope {
        focus-gained(reason) => {
            root.keyboard = reason == FocusReason.tab-navigation || root.keyboard;
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if root.tip != "": Rectangle {
        Tooltip {
            TipCard {
                Label {
                    text: root.tip;
                    font-size: Theme.small;
                    font-weight: Theme.picnic ? 800 : 700;
                }
                for note in root.notes: Muted {
                    text: note;
                    font-size: Theme.small;
                }
            }
        }
    }
}

// A line above the rows, as KDE's inline messages: paused, End's news, or a failure.
component Strip inherits Rectangle {
    in property <string> message;
    in property <Glyph> glyph;
    in property <color> tone;
    border-width: Theme.picnic ? 2px : 1px;
    border-radius: Theme.picnic ? 0 : 4px;
    border-color: root.tone;
    accessible-role: text;
    accessible-label: root.message;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            GlyphIcon {
                glyph: root.glyph;
            }
        }
        Label {
            min-height: 26px;
            text: root.message;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        @children
    }
}

// An item of the row's menu: its icon, its words and its key.
component MenuItem inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> text;
    in property <string> keys;
    in property <bool> current;
    callback clicked();
    height: 28px;
    border-radius: Theme.picnic ? 0 : 3px;
    background: self.current || touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.keys;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            GlyphIcon {
                glyph: root.glyph;
            }
        }
        Label {
            text: root.text;
            overflow: elide;
            max-width: 360px;
        }
        Rectangle {
            horizontal-stretch: 1;
            min-width: 24px;
        }
        Muted {
            text: root.keys;
            font-size: Theme.small;
        }
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Table column widths after the stretching name column.
// With an Intel or AMD GPU (`igpu` names it) the GPU column becomes two, that GPU's and NVIDIA's.
export global Columns {
    in property <string> igpu;
    out property <[length]> widths: [110px, 112px, 90px, 94px, 84px, self.igpu == "" ? 0 : 52px, self.igpu == "" ? 46px : 62px, 60px];
    out property <[string]> titles: ["RAM in use", "Swapped out", "File cache", "CPU (cores)", "Disk", self.igpu, self.igpu == "" ? "GPU" : "NVIDIA", "VRAM"];
    // The widths' sum.
    out property <length> total: self.igpu == "" ? 596px : 664px;
    // The widths from each column to the table's right end, then none.
    out property <[length]> tails: [self.total, self.total - 110px, self.total - 222px, self.total - 312px, self.total - 406px, self.total - 490px, 60px + self.widths[6], 60px, 0];
    // What each column measures, on its header (Seb's wording, #41).
    out property <string> name-about: "An app and everything it started; the arrow shows its processes.";
    out property <[string]> abouts: [
        "RAM the app holds, counting its kernel memory and zswap.",
        "The app's memory moved out of RAM to swap.",
        "Files kept in RAM for speed, freed when memory runs short.",
        "How busy the app kept the CPU; 1.00 is one full core.",
        "Data the app reads and writes per second.",
        "How busy the app kept the " + self.igpu + " GPU.",
        self.igpu == "" ? "How busy the app kept the GPU." : "How busy the app kept the NVIDIA GPU.",
        "Dedicated GPU memory the app holds.",
    ];
}

// A column's header: a click or Enter sorts by it (not the name column), and it says what the
// column measures.
component HeaderCell inherits Rectangle {
    in property <string> title;
    in property <string> about;
    in property <int> index;
    // The name column: no divider, left aligned, not sortable.
    in property <bool> name;
    in property <bool> sorted;
    in property <bool> ascending;
    in property <bool> focused;
    callback clicked();
    accessible-role: list-item;
    accessible-label: self.title;
    accessible-description: self.about;
    accessible-item-index: self.index;
    accessible-action-default => {
        self.clicked();
    }
    Rectangle {
        x: -1px;
        width: 1px;
        y: 1px;
        height: parent.height - 2px;
        visible: !Theme.picnic && !root.name;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: root.name ? 8px : 0;
        padding-right: root.name ? 0 : 8px;
        spacing: 4px;
        alignment: root.name ? start : end;
        Label {
            text: root.title;
            font-size: Theme.picnic ? Theme.small : Theme.font-size;
            font-weight: Theme.picnic ? 800 : 400;
            color: Theme.picnic ? Theme.muted : Theme.fg;
        }
        // Down: largest first.
        if root.sorted: VerticalLayout {
            alignment: center;
            Chevron {
                width: 10px;
                height: 10px;
                open: true;
                up: root.ascending;
                color: Theme.picnic ? Theme.muted : Theme.fg;
            }
        }
    }
    TouchArea {
        mouse-cursor: root.name ? default : pointer;
        clicked => {
            root.clicked();
        }
    }
    if root.focused: FocusRing {
        width: 100%;
        height: 100%;
    }
    // The focused header's tooltip is already open.
    if !root.focused: Tooltip {
        AboutTip {
            title: root.title;
            about: root.about;
        }
    }
}

component Cell inherits Label {
    in property <int> column;
    in property <color> muted: Theme.muted;
    width: Columns.widths[self.column];
    horizontal-alignment: right;
    color: self.text == "—" ? self.muted : Theme.fg;
}

component RowView inherits Rectangle {
    in property <Row> entry;
    in property <int> index;
    in property <bool> selected;
    in property <bool> focused;
    callback clicked();
    callback expand-clicked();
    // A right click, at the pointer in window coordinates.
    callback menu(length, length);
    property <bool> top: self.entry.kind == RowKind.app || self.entry.kind == RowKind.more;
    property <length> small: Theme.picnic && !self.top ? Theme.small : Theme.font-size;
    property <color> muted: self.selected ? Theme.selected-muted : Theme.muted;
    // The focused remainder row holds its explanation as a second line, below the figures.
    property <bool> show-tip: self.focused && self.entry.tip != "";
    property <length> line: Theme.picnic ? 31px : 28px;
    // Where the list shows the row: from `pin` (its sideways scroll), `visible-width` wide.
    in property <length> pin;
    in property <length> visible-width;
    // The name column with the row's left padding; the values and the right padding take the rest.
    property <length> name-width: self.width - Columns.total - 8px;
    height: self.show-tip ? self.line + tip.preferred-height + 6px : self.line;
    opacity: self.entry.ended ? 0.55 : 1;
    background: self.selected ? Theme.selection : Math.mod(self.index, 2) == 1 && !Theme.picnic ? Theme.alt : transparent;
    accessible-role: list-item;
    accessible-label: self.entry.detail == "" ? self.entry.name : self.entry.name + " " + self.entry.detail;
    // AT-SPI (AccessKit 0.24) passes on neither text values nor the expanded state, so the
    // description says both, then the tooltip.
    accessible-description: (!self.top ? "" : self.entry.expanded ? "expanded, " : "collapsed, ") + Columns.titles[0] + " " + self.entry.ram + ", " + Columns.titles[1] + " " + self.entry.swap + ", " + Columns.titles[2] + " " + self.entry.cache + ", " + Columns.titles[3] + " " + self.entry.cpu + ", " + Columns.titles[4] + " " + self.entry.disk + ", " + (Columns.igpu == "" ? "" : Columns.igpu + " GPU " + self.entry.igpu + (self.entry.igpu-tip == "" ? "" : " (" + self.entry.igpu-tip + ")") + ", ") + (Columns.igpu == "" ? "GPU " : "NVIDIA GPU ") + self.entry.gpu + ", " + Columns.titles[7] + " " + self.entry.vram + (self.entry.tip == "" ? "" : ". " + self.entry.tip);
    accessible-expandable: self.top;
    accessible-expanded: self.entry.expanded;
    accessible-item-selectable: true;
    accessible-item-selected: self.selected;
    accessible-item-index: self.index;
    accessible-action-default => {
        self.clicked();
    }
    // Expands or folds it.
    accessible-action-expand => {
        if self.top {
            self.expand-clicked();
        }
    }

    // The values, right of the name column.
    values := HorizontalLayout {
        x: root.name-width;
        y: 0;
        width: root.width - root.name-width;
        height: root.line;
        padding-right: 8px;
        Cell {
            column: 0;
            muted: root.muted;
            text: root.entry.ram;
            font-size: root.small;
            color: root.entry.kind == RowKind.more ? root.muted : Theme.fg;
        }
        Cell {
            column: 1;
            muted: root.muted;
            text: root.entry.swap;
            font-size: root.small;
        }
        Cell {
            column: 2;
            muted: root.muted;
            text: root.entry.cache;
            font-size: root.small;
        }
        Cell {
            column: 3;
            muted: root.muted;
            text: root.entry.cpu;
            font-size: root.small;
        }
        Cell {
            column: 4;
            muted: root.muted;
            text: root.entry.disk;
            font-size: root.small;
        }
        igpu-cell := Cell {
            column: 5;
            muted: root.muted;
            text: Columns.igpu == "" ? "" : root.entry.igpu;
            font-size: root.small;
        }
        Cell {
            column: 6;
            muted: root.muted;
            text: root.entry.gpu;
            font-size: root.small;
        }
        Cell {
            column: 7;
            muted: root.muted;
            text: root.entry.vram;
            font-size: root.small;
        }
    }

    // The name column stays in view while the values scroll sideways under it, opaque only
    // then: unscrolled, the card's corners and frame show through as before.
    Rectangle {
        x: root.pin;
        y: 0;
        width: root.name-width;
        height: root.line;
        background: root.pin > 0 ? Theme.view : transparent;
        clip: true;
        if root.pin > 0: Rectangle {
            background: root.background;
        }
        // The arrow under the pointer, which is what expands the row.
        Rectangle {
            x: 6px;
            y: (root.line - self.height) / 2;
            width: 20px;
            height: 20px;
            border-radius: Theme.picnic ? 0 : 3px;
            visible: root.top && arrow.has-hover;
            background: Theme.hover;
            border-width: 1px;
            border-color: Theme.accent;
        }
        HorizontalLayout {
            spacing: 6px;
            padding-left: 8px + (root.top ? 0 : 74px + (root.entry.depth - 1) * 16px);
            if root.top: VerticalLayout {
                alignment: center;
                Chevron {
                    open: root.entry.expanded;
                }
            }
            if root.top: VerticalLayout {
                alignment: center;
                Swatch {
                    kind: SegmentKind.app;
                    series: root.entry.series;
                    opacity: root.entry.series >= 0 ? 1 : 0;
                }
            }
            if root.top: VerticalLayout {
                alignment: center;
                Image {
                    width: 22px;
                    height: 22px;
                    source: root.entry.icon;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Label {
                    text: root.entry.name;
                    font-size: root.small;
                    color: root.entry.kind == RowKind.kernel || root.entry.kind == RowKind.more ? root.muted : Theme.fg;
                    font-weight: root.entry.kind == RowKind.group ? (Theme.picnic ? 800 : 700) : Theme.weight;
                    overflow: elide;
                    // The detail gives way first; a long name still elides.
                    min-width: min(self.preferred-width, 120px);
                }
                Muted {
                    text: root.entry.detail;
                    color: root.muted;
                    font-size: root.small;
                    overflow: elide;
                    min-width: 0;
                    // A lone "…" after an elided name says nothing.
                    visible: self.width >= 24px;
                }
            }
        }
    }

    if Theme.picnic: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }

    tip := Label {
        x: root.pin + 8px + 74px;
        y: root.line - 2px;
        width: root.visible-width - 8px - 74px - 16px;
        visible: root.show-tip;
        text: root.show-tip ? root.entry.tip : "";
        font-size: Theme.small;
        color: root.muted;
        wrap: word-wrap;
        vertical-alignment: TextVerticalAlignment.top;
        // Already in the row's description.
        accessible-role: none;
    }

    if root.focused: FocusRing {
        x: root.pin;
        width: root.visible-width;
        height: 100%;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    arrow := TouchArea {
        x: root.pin + 4px;
        width: root.top ? 24px : 0;
        height: root.line;
        y: 0;
        enabled: root.top;
        mouse-cursor: pointer;
        clicked => {
            root.expand-clicked();
        }
    }

    // Over the Intel or AMD cell, above the row's touch area so it gets the hover.
    if root.entry.igpu-tip != "": Rectangle {
        x: values.x + igpu-cell.x;
        y: 0;
        width: igpu-cell.width;
        height: root.line;
        Tooltip {
            TipCard {
                Label {
                    width: 320px;
                    text: root.entry.igpu-tip;
                    font-size: Theme.small;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Covers the row so the tooltip opens anywhere on it.
    if root.entry.tip != "": Rectangle {
        Tooltip {
            TipCard {
                Label {
                    width: 420px;
                    text: root.entry.tip;
                    font-size: Theme.small;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// KDE's search line: a magnifier, the hint, a clear button once typed in. Escape clears it.
component SearchField inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    height: Theme.picnic ? 30px : 28px;
    background: Theme.view;
    border-width: Theme.picnic ? 2px : 1px;
    border-radius: Theme.picnic ? 0 : 3px;
    border-color: input.has-focus ? Theme.accent : Theme.picnic ? Theme.line : #00000033;

    public function focus-input() {
        input.focus();
        input.select-all();
    }

    public function clear() {
        root.text = "";
        root.edited("");
    }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 5px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 14px;
                height: 14px;
                viewbox-width: 14;
                viewbox-height: 14;
                commands: "M 5.5 1 A 4.5 4.5 0 1 1 5.5 10 A 4.5 4.5 0 1 1 5.5 1 M 8.8 8.8 L 13 13";
                stroke: Theme.picnic ? Theme.fg : Theme.muted;
                stroke-width: Theme.picnic ? 2px : 1.2px;
            }
        }
        // Handles Escape for the input inside it; not a Tab stop of its own.
        FocusScope {
            horizontal-stretch: 1;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.text == Key.Escape && root.text != "" {
                    root.clear();
                    return accept;
                }
                reject
            }
            if root.text == "": Muted {
                width: 100%;
                text: "Search apps, groups or PIDs";
            }
            input := TextInput {
                text <=> root.text;
                color: Theme.fg;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.fg;
                single-line: true;
                vertical-alignment: center;
                accessible-label: "Search apps, groups or PIDs";
                edited => {
                    root.edited(self.text);
                }
            }
        }
        if root.text == "": Muted {
            text: "Ctrl+F";
            font-size: Theme.small;
        }
        if root.text != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                accessible-role: button;
                accessible-label: "Clear search";
                accessible-action-default => {
                    root.clear();
                }
                Path {
                    width: 16px;
                    height: 16px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: "M 4.5 4.5 L 11.5 11.5 M 11.5 4.5 L 4.5 11.5";
                    stroke: Theme.fg;
                    stroke-width: Theme.picnic ? 2px : 1px;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.clear();
                    }
                }
            }
        }
    }
}

// The name column's right edge while the values scroll sideways: a line, with a shadow over
// the values once they have scrolled under it.
component NameEdge {
    in property <bool> scrolled;
    width: 0;
    Rectangle {
        x: -self.width;
        width: Theme.picnic ? 2px : 1px;
        background: Theme.line;
    }
    if root.scrolled && Theme.picnic: Rectangle {
        x: 0;
        width: 3px;
        background: #E9C9A5;
    }
    if root.scrolled && !Theme.picnic: Rectangle {
        x: 0;
        width: 7px;
        background: @linear-gradient(90deg, (Theme.dark ? #00000088 : #00000038) 0%, transparent 100%);
    }
}

// The app table. A click selects a row, its arrow expands it. Up and Down move the selection,
// Home and End go to the ends, Right and Left (or Enter and Space) expand and fold apps; the
// model does the moving (`View::press`). Delete ends the selected row, Shift+Delete kills it;
// a right click, the menu key or Shift+F10 opens its menu.
component Table {
    in property <[Row]> rows;
    // Memory can't be split by app here: a message instead of the rows.
    in property <bool> unsplit;
    // The selected row, -1 for none.
    in property <int> current;
    callback pick(int);
    callback expand(int);
    callback key(TableKey);
    // The selected row can be ended: End and Kill show, named after it.
    in property <bool> can-end;
    in property <string> end-name;
    // With the PID, for a process.
    in property <string> end-full;
    // Why the selected row has nothing to end, for its menu.
    in property <string> nothing;
    in property <bool> paused;
    in property <string> paused-at;
    // End's news ("Still running 5 s after End.") or a failure; empty for none.
    in property <string> strip;
    in property <bool> strip-error;
    callback ask-end();
    callback ask-kill();
    callback pause-clicked();
    // The sorted column (0 for RAM in use) and its direction.
    in property <int> sort-column;
    in property <bool> sort-ascending;
    // "Filtered: 5 of 18 apps · …" while searching, else empty.
    in property <string> filtered;
    in-out property <string> search;
    callback sort(int);
    callback searched(string);
    // Focus frames only after a key, as in KDE apps.
    property <bool> keyboard;
    // The header the keyboard is on: 0 for the name, then the figures' columns.
    property <int> column;
    // Below the header, under the name's left end or a figure's right end.
    out property <KeyTip> tip: {
        shown: header.has-focus,
        x: header.absolute-position.x + (self.column == 0 ? 0 : view.content-x + self.content-width - Columns.tails[self.column]),
        y: header.absolute-position.y + header.height + 4px,
        right: self.column != 0,
        title: self.column == 0 ? "Name" : Columns.titles[self.column - 1],
        about: self.column == 0 ? Columns.name-about : Columns.abouts[self.column - 1],
    };
    out property <length> row-height: Theme.picnic ? 31px : 28px;

    // Scrolls the focused row into view.
    function reveal() {
        root.reveal-row(root.current);
    }

    // Scrolls row `i` into the list's view; none for -1.
    public function reveal-row(i: int) {
        if i < 0 {
            return;
        }
        if i * root.row-height + view.content-y < 0 {
            view.content-y = -i * root.row-height;
        }
        if (i + 1) * root.row-height + view.content-y > view.visible-height {
            view.content-y = view.visible-height - (i + 1) * root.row-height;
        }
    }

    // Row `i`'s top, in the window.
    public pure function row-top(i: int) -> length {
        view.absolute-position.y + i * root.row-height + view.content-y
    }

    function press(key: TableKey) {
        root.keyboard = true;
        root.key(key);
        root.reveal();
    }

    // Left or Right along the headers, over a column a PC without that GPU hides.
    function move-column(by: int) {
        root.column = max(0, min(Columns.titles.length, root.column + by));
        if root.column > 0 && Columns.widths[root.column - 1] == 0 {
            root.column += by;
        }
        root.reveal-column();
    }

    // Scrolls the keyboard's column out from under the name column, or in from the right.
    function reveal-column() {
        if root.column > 0 {
            view.content-x = max(Columns.tails[root.column - 1] - Columns.total, min(view.content-x, root.width - root.content-width + Columns.tails[root.column]));
        }
    }

    public function focus-search() {
        field.focus-input();
    }

    public function focus-rows() {
        scope.focus();
    }

    // The row menu, at a point in the table's coordinates.
    property <length> menu-x;
    property <length> menu-y;
    property <int> menu-current: -1;

    function open-menu(index: int, x: length, y: length) {
        root.pick(index);
        root.menu-x = x;
        root.menu-y = y;
        root.menu-current = -1;
        menu.show();
    }

    function menu-choose(kill: bool) {
        menu.close();
        if kill {
            root.ask-kill();
        } else {
            root.ask-end();
        }
    }

    public function clear-search() {
        field.clear();
    }

    property <[string]> sort-names: ["RAM in use", "swapped out", "file cache", "CPU", "disk", Columns.igpu + " GPU", Columns.igpu == "" ? "GPU" : "NVIDIA GPU", "VRAM"];
    // The name column keeps 220 px; a narrower window scrolls the table sideways.
    property <length> content-width: max(self.width, 220px + Columns.total + 16px);
    // The name column, with the rows' left padding. It stays put while the values scroll under it.
    property <length> name-width: self.content-width - Columns.total - 8px;
    property <bool> overflows: self.width < self.content-width;
    property <bool> scrolled: view.content-x < 0;

    VerticalLayout {
        // The search line above the table, as in KDE System Monitor; SebChat titles it "Apps".
        HorizontalLayout {
            padding-top: Theme.picnic ? 0 : 10px;
            padding-left: Theme.picnic ? 14px : 12px;
            padding-right: self.padding-left;
            padding-bottom: Theme.picnic ? 8px : 10px;
            spacing: 12px;
            if Theme.picnic: SectionTitle {
                text: "Apps";
            }
            field := SearchField {
                width: 300px;
                text <=> root.search;
                edited(text) => {
                    root.searched(text);
                }
            }
            // The two share the room up to Pause, each ending its name in an ellipsis.
            if root.can-end: HorizontalLayout {
                spacing: 12px;
                horizontal-stretch: 0;
                PushButton {
                    max-width: 260px;
                    glyph: Glyph.end;
                    text: "End " + root.end-name;
                    tip: "End " + root.end-full;
                    notes: ["Asks it to close, as closing its window would.", "Delete"];
                    clicked => {
                        root.ask-end();
                    }
                }
                PushButton {
                    max-width: 260px;
                    glyph: Glyph.kill;
                    text: "Kill " + root.end-name;
                    tip: "Kill " + root.end-full;
                    notes: ["Stops it at once; unsaved work is lost.", "Shift+Delete"];
                    clicked => {
                        root.ask-kill();
                    }
                }
            }
            if root.filtered != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    background: Theme.selection;
                    border-radius: Theme.picnic ? 0 : 3px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        Label {
                            text: root.filtered;
                            font-size: Theme.small;
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if Theme.picnic: Muted {
                text: "sorted by " + root.sort-names[root.sort-column];
                font-size: Theme.small;
                font-weight: 800;
                horizontal-alignment: right;
            }
            PushButton {
                min-width: self.preferred-width;
                glyph: root.paused ? Glyph.play : Glyph.pause;
                text: root.paused ? "Resume" : "Pause";
                on: root.paused;
                tip: self.text;
                notes: [root.paused ? "Reads again and updates the window." : "Freezes the window: SebWatch stops reading until you resume."];
                clicked => {
                    root.pause-clicked();
                }
            }
        }
        if root.paused || root.strip != "": VerticalLayout {
            padding-left: Theme.picnic ? 14px : 12px;
            padding-right: self.padding-left;
            padding-bottom: Theme.picnic ? 8px : 10px;
            spacing: 6px;
            if root.paused: Strip {
                glyph: Glyph.info;
                tone: Theme.accent;
                background: Theme.info-bg;
                message: "Paused at " + root.paused-at + ". Nothing updates until you resume.";
            }
            if root.strip != "": Strip {
                glyph: root.strip-error ? Glyph.kill : Glyph.warn;
                tone: root.strip-error ? Theme.negative : Theme.warning;
                background: root.strip-error ? Theme.negative-bg : Theme.warning-bg;
                message: root.strip;
                if !root.strip-error && root.can-end: VerticalLayout {
                    alignment: center;
                    PushButton {
                        max-width: 260px;
                        glyph: Glyph.kill;
                        text: "Kill " + root.end-name;
                        clicked => {
                            root.ask-kill();
                        }
                    }
                }
            }
        }
        // The header: Breeze's column dividers, or SebChat's small muted labels over a thick line.
        // One Tab stop: Left and Right move between the columns, Enter or Space sorts.
        header := FocusScope {
            height: Theme.picnic ? 31px : 29px;
            focus-on-click: false;
            accessible-role: list;
            accessible-label: "Columns";
            accessible-item-count: Columns.titles.length + 1;
            accessible-delegate-focus: root.column;
            focus-gained => {
                root.reveal-column();
            }
            key-pressed(event) => {
                if event.modifiers.control || event.modifiers.alt {
                    return reject;
                }
                if event.text == Key.LeftArrow {
                    root.move-column(-1);
                } else if event.text == Key.RightArrow {
                    root.move-column(1);
                } else if event.text == Key.Home {
                    root.column = 0;
                } else if event.text == Key.End {
                    root.column = Columns.titles.length;
                    root.reveal-column();
                } else if event.text == Key.Return || event.text == " " {
                    if root.column > 0 {
                        root.sort(root.column - 1);
                    }
                } else {
                    return reject;
                }
                accept
            }
            Rectangle {
                background: Theme.picnic ? transparent : Theme.view;
                clip: true;
                Rectangle {
                    y: 0;
                    height: 1px;
                    visible: !Theme.picnic;
                    background: Theme.line;
                }
                Rectangle {
                    y: parent.height - self.height;
                    height: Theme.picnic ? 3px : 1px;
                    background: Theme.line;
                }
                // Scrolls sideways with the rows. Its columns end 8 px right of the rows' cells, so
                // the titles, padded 8 px, end where the figures do.
                HorizontalLayout {
                    x: view.content-x + root.content-width - Columns.total;
                    width: Columns.total;
                    for title[i] in Columns.titles: HeaderCell {
                        width: Columns.widths[i];
                        visible: self.width > 0;
                        title: title;
                        about: Columns.abouts[i];
                        index: i + 1;
                        sorted: i == root.sort-column;
                        ascending: root.sort-ascending;
                        focused: header.has-focus && root.column == i + 1;
                        clicked => {
                            root.sort(i);
                        }
                    }
                }
                // Stays put over the figures, opaque between the header's lines once they scroll.
                if root.scrolled: Rectangle {
                    x: 0;
                    y: Theme.picnic ? 0 : 1px;
                    width: root.name-width;
                    height: parent.height - self.y - (Theme.picnic ? 3px : 1px);
                    background: Theme.view;
                }
                HeaderCell {
                    x: 0;
                    width: root.content-width - Columns.total;
                    name: true;
                    title: "Name";
                    about: Columns.name-about;
                    index: 0;
                    focused: header.has-focus && root.column == 0;
                }
                NameEdge {
                    x: root.name-width;
                    visible: root.overflows;
                    scrolled: root.scrolled;
                }
            }
        }
        // A system that can't split memory by app: KDE's placeholder message for an empty view.
        if root.unsplit: Rectangle {
            vertical-stretch: 1;
            background: Theme.picnic ? transparent : Theme.view;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                padding-left: 60px;
                padding-right: 60px;
                Text {
                    text: "SebWatch can't split memory by app on this system";
                    color: Theme.muted;
                    font-size: 18px;
                    font-family: Theme.title-font;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Muted {
                    text: "It needs cgroup v2 memory accounting and the per-app groups a systemd user session creates; this system has neither. The bars above still show the totals.";
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        // The rows are the scope's only accessible children, so the screen reader's focus follows
        // the focused row.
        scope := FocusScope {
            visible: !root.unsplit;
            // Hidden, it takes no room from the message. A short window keeps about 8 rows; the
            // page scrolls instead.
            min-height: root.unsplit ? 0 : 8 * root.row-height;
            max-height: root.unsplit ? 0 : 100000px;
            accessible-role: list;
            accessible-label: "Apps";
            accessible-item-count: root.rows.length;
            accessible-delegate-focus: root.current;
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation {
                    root.keyboard = true;
                    if root.current < 0 {
                        root.key(TableKey.home);
                    }
                    root.reveal();
                }
            }
            key-pressed(event) => {
                if event.modifiers.control || event.modifiers.alt {
                    return reject;
                }
                if event.text == Key.Delete {
                    if root.can-end {
                        if event.modifiers.shift {
                            root.ask-kill();
                        } else {
                            root.ask-end();
                        }
                    }
                    return accept;
                }
                if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) && root.current >= 0 {
                    root.keyboard = true;
                    root.reveal();
                    root.open-menu(root.current, 120px, self.y + (root.current + 1) * root.row-height + view.content-y);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.press(TableKey.up);
                } else if event.text == Key.DownArrow {
                    root.press(TableKey.down);
                } else if event.text == Key.Home {
                    root.press(TableKey.home);
                } else if event.text == Key.End {
                    root.press(TableKey.end);
                } else if event.text == Key.LeftArrow {
                    root.press(TableKey.left);
                } else if event.text == Key.RightArrow {
                    root.press(TableKey.right);
                } else if event.text == Key.Return || event.text == " " {
                    root.press(TableKey.toggle);
                } else {
                    return reject;
                }
                accept
            }
            // A list view makes only the rows in sight: an expanded app can hold thousands. The
            // scope stays the screen reader's list.
            view := ListView {
                accessible-role: none;
                content-width: root.content-width;
                // Its own bar would run under the name column too; `values-bar` runs under the values only.
                horizontal-scrollbar-policy: always-off;
                for row[i] in root.rows: RowView {
                    width: root.content-width;
                    pin: -view.content-x;
                    visible-width: view.visible-width;
                    entry: row;
                    index: i;
                    selected: i == root.current;
                    focused: i == root.current && scope.has-focus && root.keyboard;
                    clicked => {
                        root.keyboard = false;
                        scope.focus();
                        root.pick(i);
                    }
                    expand-clicked => {
                        scope.focus();
                        root.expand(i);
                    }
                    menu(x, y) => {
                        root.keyboard = false;
                        scope.focus();
                        root.open-menu(i, x - root.absolute-position.x, y - root.absolute-position.y);
                    }
                }
            }
        }
    }

    // The row's menu: End and Kill, or why there is nothing to end. Up and Down move, Enter
    // picks, Escape closes.
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        Rectangle {
            background: Theme.popup;
            border-width: Theme.picnic ? 2px : 1px;
            border-color: Theme.picnic ? Theme.outline : Theme.line;
            border-radius: Theme.picnic ? 0 : 4px;
            drop-shadow-blur: Theme.picnic ? 0 : 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-offset-x: Theme.picnic ? 3px : 0;
            drop-shadow-color: Theme.picnic ? #5B331C30 : #00000050;
            FocusScope {
                init => {
                    self.focus();
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        menu.close();
                        scope.focus();
                    } else if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Tab {
                        root.menu-current = root.menu-current == 0 ? 1 : 0;
                    } else if event.text == Key.Return || event.text == " " {
                        if root.can-end && root.menu-current >= 0 {
                            root.menu-choose(root.menu-current == 1);
                        }
                    } else {
                        return reject;
                    }
                    accept
                }
                VerticalLayout {
                    padding: Theme.picnic ? 6px : 4px;
                    if root.can-end: MenuItem {
                        glyph: Glyph.end;
                        text: "End " + root.end-name;
                        keys: "Delete";
                        current: root.menu-current == 0;
                        clicked => {
                            root.menu-choose(false);
                        }
                    }
                    if root.can-end: MenuItem {
                        glyph: Glyph.kill;
                        text: "Kill " + root.end-name;
                        keys: "Shift+Delete";
                        current: root.menu-current == 1;
                        clicked => {
                            root.menu-choose(true);
                        }
                    }
                    if !root.can-end: HorizontalLayout {
                        padding: 6px;
                        padding-left: 8px;
                        padding-right: 8px;
                        Muted {
                            text: root.nothing;
                            accessible-role: text;
                            accessible-label: self.text;
                        }
                    }
                }
            }
            NameEdge {
                x: root.name-width;
                height: min(parent.height, root.rows.length * root.row-height + view.content-y);
                visible: root.overflows;
                scrolled: root.scrolled;
            }
            // Shares the list's sideways scroll; as wide as the values that scroll, less the
            // vertical bar's corner.
            values-bar := ScrollView {
                x: root.name-width;
                y: parent.height - self.height;
                width: parent.width - root.name-width - 14px;
                height: 14px;
                min-height: 0;
                visible: root.overflows;
                vertical-scrollbar-policy: always-off;
                content-width: self.width + root.content-width - view.visible-width;
                content-height: self.height;
                content-x <=> view.content-x;
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <Bar> memory;
    in property <Bar> swap;
    in property <SwapInfo> swap-info;
    // No NVIDIA GPU: no VRAM bar.
    in property <bool> has-vram;
    in property <Bar> vram;
    in property <[Tile]> tiles;
    in property <[Row]> rows;
    // "Not updating: …" while readings fail, else empty.
    in property <string> warning;
    // Memory can't be split by app on this system.
    in property <bool> unsplit;
    // The selected row, -1 for none.
    in property <int> current: -1;
    // End and Kill for the selected row (`Table`); `end-asks` for a desktop part, which End
    // confirms first.
    in property <bool> can-end;
    in property <string> end-name;
    in property <string> end-full;
    in property <bool> end-asks;
    in property <string> nothing;
    in property <bool> paused;
    in property <string> paused-at;
    in property <string> strip;
    in property <bool> strip-error;
    // The row the strip is about.
    in property <string> strip-key;
    callback end();
    callback kill();
    callback pause-clicked();
    callback expand(int);
    in property <int> sort-column;
    in property <bool> sort-ascending;
    in property <string> filtered;
    in-out property <string> search;
    callback pick(int);
    callback key(TableKey);
    // A click on a bar's section, by its key: selects or deselects its app's row, or opens the
    // fold (#88). Gives the row to scroll to, -1 for none.
    callback bar-picked(string) -> int;
    callback deselect();
    // A click on a column's header, 0 for RAM in use.
    callback sort-clicked(int);
    // The search field's new text.
    callback searched(string);
    callback theme-chosen(ThemeChoice);

    in property <string> version;

    // The confirmation open: none, Kill, or End for a desktop part.
    property <int> asking;
    property <int> asking-kill: 1;
    property <int> asking-end: 2;

    // The model selects the row or opens the fold; then the table, and in a short window the
    // page, scroll to its row.
    function pick-section(key: string) {
        let i = root.bar-picked(key);
        if i < 0 {
            return;
        }
        table.reveal-row(i);
        let top = table.row-top(i) - page.absolute-position.y;
        let lowest = page.visible-height - page.content-height;
        if top < 0 {
            page.content-y = min(0, page.content-y - top);
        } else if top + table.row-height > page.visible-height {
            page.content-y = max(lowest, page.content-y - (top + table.row-height - page.visible-height));
        }
    }

    function ask-end() {
        if root.end-asks {
            root.asking = root.asking-end;
        } else {
            root.end();
        }
    }

    function answer(yes: bool) {
        if yes && root.asking == root.asking-kill {
            root.kill();
        } else if yes {
            root.end();
        }
        root.asking = 0;
        table.focus-rows();
    }

    title: "SebWatch " + root.version;
    icon: @image-url("../../../art/icons/hicolor/256x256/apps/sebwatch.png");
    preferred-width: 1000px;
    preferred-height: 850px;
    min-width: 760px;
    // A window wide enough for the tiles two by two beside one-line legends.
    property <bool> wide: self.width >= 1400px;
    // Every card's outer margin is 16 px; the gap between cards is the tiles' gap.
    property <length> gap: Theme.picnic ? 14px : 8px;
    property <length> tiles-width: self.wide ? 2 * 180px + self.gap : 180px;
    property <length> bars-inset: Theme.picnic ? 14px : 12px;
    min-height: 480px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.font-size;
    default-font-weight: Theme.weight;
    forward-focus: keys;

    if Theme.picnic: Image {
        width: 100%;
        height: 100%;
        source: Art.cloth;
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        image-rendering: pixelated;
    }

    // Ctrl+F finds an app from anywhere in the window; Escape clears the search.
    keys := FocusScope {
        // Tab goes from the menu button to the tiles, the search field, the header and the table.
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                table.focus-search();
                return accept;
            }
            if event.text == Key.Escape && root.search != "" {
                table.clear-search();
                return accept;
            }
            if event.text == Key.Escape && root.current >= 0 {
                root.deselect();
                return accept;
            }
            reject
        }
        // A window too short for the bars and about 8 table rows scrolls as one page.
        page := ScrollView {
            content-width: self.visible-width;
            content-height: max(self.visible-height, content.min-height);
            content := VerticalLayout {
                width: page.visible-width;
                height: page.content-height;
                padding: 16px;
                spacing: root.gap;
                // Readings failing: KDE's inline warning (KMessageWidget) above the bars.
                if root.warning != "": HorizontalLayout {
                    Rectangle {
                        accessible-role: text;
                        accessible-label: "Warning";
                        accessible-description: root.warning;
                        background: Theme.warning-bg;
                        border-width: 1px;
                        border-color: Theme.warning;
                        border-radius: Theme.picnic ? 0 : 4px;
                        HorizontalLayout {
                            padding: 8px;
                            padding-left: 10px;
                            spacing: 9px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    Path {
                                        width: 18px;
                                        height: 18px;
                                        viewbox-width: 18;
                                        viewbox-height: 18;
                                        commands: "M 9 1.5 L 17 16 L 1 16 Z";
                                        fill: Theme.warning;
                                    }
                                    Text {
                                        y: 4px;
                                        height: 12px;
                                        text: "!";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Label {
                                text: root.warning;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                // As short as the taller of the tiles and the bars allow, leaving the rest to
                // the table.
                Rectangle {
                    vertical-stretch: 0;
                    height: top.min-height;
                    top := HorizontalLayout {
                        spacing: root.gap;
                        // The tiles first, two by two in a wide window, so the top stays as short
                        // as the bars; they share out the bars' height when the bars are taller.
                        // Their room only: the tiles come after the bars, so Tab reaches the menu
                        // button first.
                        tiles-room := Rectangle {
                            width: root.tiles-width;
                            min-height: tiles.needs;
                        }
                        // The bars' card runs as deep as the tiles beside it; the bars share out
                        // the spare height in equal gaps, so the last legend ends on the card's edge.
                        Card {
                            inset: root.bars-inset;
                            BarView {
                                bar: root.memory;
                                picked(key) => {
                                    root.pick-section(key);
                                }
                                // Hangs 6 px into the card's inset.
                                Rectangle {
                                    width: 30px;
                                    MenuButton {
                                        x: 6px;
                                        y: (parent.height - self.height) / 2;
                                        chosen(choice) => {
                                            root.theme-chosen(choice);
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                min-height: Theme.picnic ? 18px : 14px;
                                vertical-stretch: 1;
                            }
                            BarView {
                                bar: root.swap;
                                picked(key) => {
                                    root.pick-section(key);
                                }
                                explained: true;
                                info: root.swap-info;
                            }
                            if root.has-vram: Rectangle {
                                min-height: Theme.picnic ? 18px : 14px;
                                vertical-stretch: 1;
                            }
                            if root.has-vram: BarView {
                                bar: root.vram;
                                picked(key) => {
                                    root.pick-section(key);
                                }
                            }
                        }
                    }
                    tiles := TileStrip {
                        x: tiles-room.x;
                        y: tiles-room.y;
                        width: tiles-room.width;
                        height: tiles-room.height;
                        tiles: root.tiles;
                        wide: root.wide;
                        gap: root.gap;
                    }
                }
                // The Apps card: the search line, then the table clipped to the card's corners.
                Card {
                    inset: 0;
                    clip-content: true;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-top: Theme.picnic ? 12px : 0;
                        padding-bottom: Theme.picnic ? 6px : 0;
                        padding-left: Theme.picnic ? 3px : 0;
                        padding-right: Theme.picnic ? 3px : 0;
                        table := Table {
                            rows: root.rows;
                            unsplit: root.unsplit;
                            current: root.current;
                            sort-column: root.sort-column;
                            sort-ascending: root.sort-ascending;
                            pick(index) => {
                                root.pick(index);
                            }
                            expand(index) => {
                                root.expand(index);
                            }
                            can-end: root.can-end;
                            end-name: root.end-name;
                            end-full: root.end-full;
                            nothing: root.nothing;
                            paused: root.paused;
                            paused-at: root.paused-at;
                            strip: root.strip;
                            strip-error: root.strip-error;
                            ask-end => {
                                root.ask-end();
                            }
                            ask-kill => {
                                root.asking = root.asking-kill;
                            }
                            pause-clicked => {
                                root.pause-clicked();
                            }
                            key(key) => {
                                root.key(key);
                            }
                            sort(column) => {
                                root.sort-clicked(column);
                            }
                            filtered: root.filtered;
                            search <=> root.search;
                            searched(text) => {
                                root.searched(text);
                            }
                        }
                    }
                }
            }
        }
    }

    // Over everything, so neither the cards nor the rows cover them.
    if tiles.tip.shown: FocusTip {
        tip: tiles.tip;
        room: root.width;
    }
    if table.tip.shown: FocusTip {
        tip: table.tip;
        room: root.width;
    }

    // Kill, or End on a desktop part, asks first. Cancel has the focus; Escape cancels.
    if root.asking != 0: Rectangle {
        background: Theme.picnic ? #5B331C55 : Theme.dark ? #00000077 : #00000044;
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.answer(false);
                    return accept;
                }
                reject
            }
            Card {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 440px;
                height: self.preferred-height;
                inset: 18px;
                fill: Theme.picnic ? Theme.view : Theme.bg;
                accessible-role: groupbox;
                accessible-label: title.text;
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start;
                        GlyphIcon {
                            glyph: Glyph.warn;
                            size: 32px;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        title := Label {
                            text: (root.asking == root.asking-kill ? "Kill " : "End ") + root.end-full + "?";
                            font-weight: Theme.picnic ? 800 : 700;
                            wrap: word-wrap;
                        }
                        Label {
                            text: root.asking == root.asking-kill ? "It stops at once. Unsaved work is lost." : "It is part of the desktop: ending it can close your session or leave the screen blank.";
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            padding-top: 12px;
                            spacing: 8px;
                            alignment: LayoutAlignment.end;
                            PushButton {
                                glyph: root.asking == root.asking-kill ? Glyph.kill : Glyph.end;
                                text: root.asking == root.asking-kill ? "Kill" : "End";
                                clicked => {
                                    root.answer(true);
                                }
                            }
                            cancel := PushButton {
                                text: "Cancel";
                                init => {
                                    self.focus-button();
                                }
                                clicked => {
                                    root.answer(false);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
