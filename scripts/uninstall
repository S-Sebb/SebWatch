#!/usr/bin/env bash
# Removes what scripts/install put into PREFIX (default ~/.local).
set -euo pipefail
cd "$(dirname "$0")/.."
prefix=${1:-$HOME/.local}

rm -f "$prefix/bin/sebwatch" "$prefix/share/applications/sebwatch.desktop"
for icon in art/icons/hicolor/*/apps/sebwatch.png; do
    rm -f "$prefix/share/icons/${icon#art/icons/}"
done

scripts/refresh-caches "$prefix"
echo "Removed SebWatch from $prefix"
