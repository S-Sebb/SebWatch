#!/usr/bin/env bash
# Installs into a throwaway prefix, checks the files and the desktop entry, uninstalls and checks nothing is left.
# Usage: scripts/test-install [PREFIX] (default: a fresh folder in target/). Full logs in target/logs/.
set -u
cd "$(dirname "$0")/.."
prefix=${1:-$(mkdir -p target && mktemp -d target/install-test.XXXX)}
logs=target/logs
mkdir -p "$logs"

for tool in cargo desktop-file-validate; do
    command -v $tool >/dev/null || { echo "MISSING: $tool not found"; exit 1; }
done

status=0
check() { # name timeout command...
    local name=$1 limit=$2; shift 2
    if timeout "$limit" "$@" >"$logs/$name.log" 2>&1; then
        echo "PASS $name"
    else
        echo "FAIL $name (see $logs/$name.log)"
        status=1
    fi
}

icons=(art/icons/hicolor/*/apps/sebwatch.png)
files=(bin/sebwatch share/applications/sebwatch.desktop "${icons[@]/#art\/icons/share/icons}")

check install 1200 scripts/install "$prefix"
check files-installed 10 bash -c 'for f; do [ -f "$f" ] || { echo "missing $f"; exit 1; }; done' _ "${files[@]/#/$prefix/}"
check desktop-file-validate 10 desktop-file-validate "$prefix/share/applications/sebwatch.desktop"
check uninstall 60 scripts/uninstall "$prefix"
check files-removed 10 bash -c 'for f; do [ ! -e "$f" ] || { echo "left $f"; exit 1; }; done' _ "${files[@]/#/$prefix/}"
exit $status
